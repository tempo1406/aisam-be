<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Statistics Report</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f5f5f5;">
    <table role="presentation" style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="padding: 40px 20px;">
                <table role="presentation" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    <!-- Header -->
                    <tr>
                        <td style="padding: 32px 40px; background-color: #4F46E5; text-align: center;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600;">Daily Statistics Report</h1>
                            <p style="margin: 8px 0 0 0; color: #E0E7FF; font-size: 14px;">{{date}}</p>
                        </td>
                    </tr>

                    <!-- Greeting -->
                    <tr>
                        <td style="padding: 32px 40px 24px 40px;">
                            <p style="margin: 0; color: #111827; font-size: 16px;">Hi {{username}},</p>
                            <p style="margin: 16px 0 0 0; color: #6B7280; font-size: 14px; line-height: 1.6;">Here's your social media performance summary for today:</p>
                        </td>
                    </tr>

                    <!-- Summary Cards -->
                    <tr>
                        <td style="padding: 0 40px 32px 40px;">
                            <table role="presentation" style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 50%; padding-right: 8px;">
                                        <div style="background-color: #F9FAFB; border-radius: 6px; padding: 20px; text-align: center; border: 1px solid #E5E7EB;">
                                            <div style="font-size: 28px; font-weight: 700; color: #4F46E5; margin-bottom: 4px;">{{totalPosts}}</div>
                                            <div style="font-size: 12px; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px;">Posts</div>
                                        </div>
                                    </td>
                                    <td style="width: 50%; padding-left: 8px;">
                                        <div style="background-color: #F9FAFB; border-radius: 6px; padding: 20px; text-align: center; border: 1px solid #E5E7EB;">
                                            <div style="font-size: 28px; font-weight: 700; color: #DC2626; margin-bottom: 4px;">{{totalLikes}}</div>
                                            <div style="font-size: 12px; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px;">Likes</div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="height: 16px;"></td>
                                </tr>
                                <tr>
                                    <td style="width: 50%; padding-right: 8px;">
                                        <div style="background-color: #F9FAFB; border-radius: 6px; padding: 20px; text-align: center; border: 1px solid #E5E7EB;">
                                            <div style="font-size: 28px; font-weight: 700; color: #059669; margin-bottom: 4px;">{{totalComments}}</div>
                                            <div style="font-size: 12px; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px;">Comments</div>
                                        </div>
                                    </td>
                                    <td style="width: 50%; padding-left: 8px;">
                                        <div style="background-color: #F9FAFB; border-radius: 6px; padding: 20px; text-align: center; border: 1px solid #E5E7EB;">
                                            <div style="font-size: 28px; font-weight: 700; color: #EA580C; margin-bottom: 4px;">{{totalShares}}</div>
                                            <div style="font-size: 12px; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px;">Shares</div>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Detailed Table -->
                    <tr>
                        <td style="padding: 0 40px 32px 40px;">
                            <h2 style="margin: 0 0 16px 0; color: #111827; font-size: 18px; font-weight: 600;">Breakdown by Page</h2>
                            <table role="presentation" style="width: 100%; border-collapse: collapse; border: 1px solid #E5E7EB; border-radius: 6px; overflow: hidden;">
                                <thead>
                                    <tr style="background-color: #F9FAFB;">
                                        <th style="padding: 12px; text-align: left; font-size: 12px; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #E5E7EB;">Page</th>
                                        <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #E5E7EB;">Posts</th>
                                        <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #E5E7EB;">Likes</th>
                                        <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #E5E7EB;">Comments</th>
                                        <th style="padding: 12px; text-align: center; font-size: 12px; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #E5E7EB;">Shares</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each statistics}}
                                    <tr style="{{#unless @last}}border-bottom: 1px solid #E5E7EB;{{/unless}}">
                                        <td style="padding: 12px; font-size: 14px; color: #111827; font-weight: 500;">{{this.page}}</td>
                                        <td style="padding: 12px; text-align: center; font-size: 14px; color: #6B7280;">{{this.posts}}</td>
                                        <td style="padding: 12px; text-align: center; font-size: 14px; color: #6B7280;">{{this.likes}}</td>
                                        <td style="padding: 12px; text-align: center; font-size: 14px; color: #6B7280;">{{this.comments}}</td>
                                        <td style="padding: 12px; text-align: center; font-size: 14px; color: #6B7280;">{{this.shares}}</td>
                                    </tr>
                                    {{/each}}
                                </tbody>
                            </table>
                        </td>
                    </tr>

                    <!-- CTA Button -->
                    <tr>
                        <td style="padding: 0 40px 32px 40px; text-align: center;">
                            <a href="{{url}}/statistics" style="display: inline-block; padding: 12px 32px; background-color: #4F46E5; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 600;">View Full Report</a>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 24px 40px; background-color: #F9FAFB; border-top: 1px solid #E5E7EB;">
                            <p style="margin: 0 0 8px 0; color: #6B7280; font-size: 12px; text-align: center;">© {{year}} AISAM. All rights reserved.</p>
                            <p style="margin: 0; text-align: center;">
                                <a href="{{url}}/settings" style="color: #4F46E5; text-decoration: none; font-size: 12px; margin: 0 8px;">Settings</a>
                                <span style="color: #D1D5DB;">|</span>
                                <a href="{{url}}/support" style="color: #4F46E5; text-decoration: none; font-size: 12px; margin: 0 8px;">Support</a>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
